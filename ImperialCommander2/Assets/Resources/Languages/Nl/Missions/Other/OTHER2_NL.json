  "events": [
    {
      "eventName": "End of Mission - Rebels lose",
      "GUID": "9e960fce-d271-468c-8d6c-233bc752aa52",
      "eventText": "Ernstig gewond weet je team, ondanks het hevige vuur van de AT‑ST, het terrein te ontvluchten. Pas later ontdek je dat je datapad geraakt is en onherstelbaar beschadigd.\n\n{-} De rebellen verliezen de missie.\n{-} Elke held krijgt 1 XP. De helden krijgen 100 credits per held.",
      "eventActions": []
    },
    {
      "eventName": "End of Mission - Rebels win",
      "GUID": "69b80fad-5e0e-46cd-a70e-defa45de4db6",
      "eventText": "De laatste klap doet de cockpit van de AT‑ST exploderen in een verblindende flits. Stukken vervormd metaal worden hoog de nachtelijke hemel in geslingerd. Te midden van de chaos ontsnapt je team uit de basis, met de waardevolle gegevens veilig in handen.\r\n\r\n{-} De rebellen winnen de missie!\n{-} De helden krijgen <color=\"red\">Luke Skywalker</color> (Jedi Knight) als bondgenoot.\n{-} Elke held krijgt 1 XP. De helden krijgen 100 credits per held.",
      "eventActions": []
    },
    {
      "eventName": "Mission Briefing",
      "GUID": "edc56ae0-7e4f-4ecd-9176-26e69bfd835a",
      "eventText": "Je shuttle landt; de basis is stil en gehuld in duisternis. Langzaam loop je de loopplank af, je wapens gereed.\n\n{-} Plaats de helden op het blauw gemarkeerde veld.\n{-} Pas -2 nauwkeurigheid toe op alle {O} aanvallen. Negeer alle andere negatieve effecten op nauwkeurigheid.",
      "eventActions": [
        {
          "tbText": "In de verte zie je een deur die twee delen van de basis met elkaar verbindt. De terminal moet zich daar ergens achter bevinden.",
          "GUID": "23c66661-c931-456b-8185-cb5ce56f5e64",
          "eventActionType": 16,
          "eaName": "Text Box"
        },
        {
          "translatedEntityProperties": [
            {
              "entityName": "Terminal",
              "GUID": "cd7cc2c8-c966-43fb-987e-6400529e77f4",
              "theText": "In het donker kun je nog maar net de contouren onderscheiden van de terminal die mogelijk de vlootgegevens bevat.",
              "buttonList": [
                {
                  "GUID": "92ed4a42-8daf-4622-9acf-68c49817c585",
                  "theText": "{A} Download de data"
                }
              ]
            }
          ],
          "GUID": "32810272-7808-48aa-811a-2f8ce576a512",
          "eventActionType": 15,
          "eaName": "Modify Map Entity"
        },
        {
          "tbText": "{-} Een rebellenfiguur kan een interactie uitvoeren op de terminal om de vlootgegevens te downloaden.",
          "GUID": "131c545a-574f-4c7b-b382-506320f5839a",
          "eventActionType": 16,
          "eaName": "Text Box"
        },
        {
          "tbText": "Je struikelt in het donker, nog voordat Luke de shuttle kan verlaten. Hiermee trek je meteen de aandacht van een patrouille.\n\n{-} De deur is vergrendeld.\n{-} De missie gaat verder wanneer een rebellenfiguur de vlootgegevens downloadt.\n{-} De rebellen verliezen als alle helden gewond zijn.",
          "GUID": "ef2f3b48-1822-4e6a-8acd-a21e2de39c6b",
          "eventActionType": 16,
          "eaName": "Text Box"
        },
        {
          "shortText": "Download de vlootgegevens.",
          "longText": "",
          "GUID": "7d83056a-3a77-4d2c-a292-e8bf8c8ae3d5",
          "eventActionType": 2,
          "eaName": "Change Objective"
        },
        {
          "theText": "{-} Pas -2 nauwkeurigheid toe op alle {O} aanvallen. Negeer alle andere negatieve effecten op nauwkeurigheid.\r\n{-} De deur is vergrendeld.\r\n{-} Een rebellenfiguur kan een interactie uitvoeren op de terminal om de vlootgegevens te downloaden.\r\n{-} De missie gaat verder wanneer een rebellenfiguur de vlootgegevens downloadt.\n{-} De rebellen verliezen als alle helden gewond zijn.",
          "GUID": "c5879082-5ef3-4f8b-84dc-2edd5675240a",
          "eventActionType": 1,
          "eaName": "Change Mission Info"
        }
      ]
    },
