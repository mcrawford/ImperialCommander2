    {
      "eventName": "The Trap is Sprung",
      "GUID": "579cf568-605c-4892-8d63-b7916da7cdce",
      "eventText": "Net wanneer je de gegevens downloadt, springt er een beveiligingswaarschuwing op het scherm. Dit was allemaal een valstrik.",
      "eventActions": [
        {
          "translatedEntityProperties": [
            {
              "entityName": "Terminal",
              "GUID": "e26fe7fe-c854-4a27-aea2-2dcb98cffdbe",
